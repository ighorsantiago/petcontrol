{
  "expo": {
    "name": "Pet Control",
    "slug": "petcontrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petcontrol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3E84A8"
    },
    "ios": {
      "bundleIdentifier": "com.ighorsantiago.petcontrol",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3E84A8"
      },
      "package": "com.ighorsantiago.petcontrol",
      "googleServicesFile": "./google-services.json",
      "privacyPolicyUrl": "https://sites.google.com/view/pet-control-poltica-de-privaci",
      "targetSdkVersion": 35,
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-build-properties", {
        "android": {
          "targetSdkVersion": 35,
          "compileSdkVersion": 35
        }
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "822d28cd-e430-4913-89a2-593961fe8868"
      }
    }
  }
}
